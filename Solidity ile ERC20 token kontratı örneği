pragma solidity ^0.8.20;

// OZ paketini projeye kur: npm i @openzeppelin/contracts
import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
// İsteğe bağlı: duraklatma, yakma
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Burnable.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Pausable.sol";

contract MyToken is ERC20, ERC20Burnable, ERC20Pausable, Ownable {
    constructor(
        string memory name_,
        string memory symbol_,
        uint256 initialSupply // 18 ondalık varsayımıyla
    ) ERC20(name_, symbol_) Ownable(msg.sender) {
        _mint(msg.sender, initialSupply);
    }

    // Sadece owner yeni token basabilir (opsiyonel)
    function mint(address to, uint256 amount) external onlyOwner {
        _mint(to, amount);
    }

    // Transfer hook'u: Pausable ile entegre
    function _update(address from, address to, uint256 value)
        internal
        override(ERC20, ERC20Pausable)
    {
        super._update(from, to, value);
    }

    // 18 yerine farklı decimals istiyorsan override et:
    // function decimals() public pure override returns (uint8) { return 6; }
}
